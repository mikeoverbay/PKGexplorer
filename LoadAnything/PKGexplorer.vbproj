<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Retargeted from .NET Framework 4.8 to net8.0-windows so the viewer can use
    OpenTK 4.x (which cannot be referenced from .NET Framework at all).

    Two assemblies went with the move, both mixed-mode C++/CLI and therefore
    unloadable on .NET 8:
      FbxSDK.dll  - drove the old FBX exporter.  Both are deleted; the format
                    it wrote was years out of date and OBJ / STL / GLB replace
                    it, through Exporter Studio's writers.
      SlimDX.dll  - nothing in the source ever referenced it.

    Still x86: DevIL.dll / ILU.dll / ILUT.dll / freeglut.dll next to the exe are
    native 32-bit, so the process has to stay 32-bit until those are replaced.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>pkg_viewer</RootNamespace>
    <AssemblyName>PKGviewer</AssemblyName>
    <MyType>WindowsForms</MyType>
    <StartupObject>pkg_viewer.My.MyApplication</StartupObject>

    <OptionStrict>Off</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionCompare>Text</OptionCompare>
    <OptionInfer>On</OptionInfer>

    <Platforms>x86;AnyCPU</Platforms>
    <PlatformTarget>x86</PlatformTarget>

    <ApplicationIcon>PKG.ico</ApplicationIcon>
    <ApplicationManifest>My Project\app.manifest</ApplicationManifest>

    <!-- AssemblyInfo.vb is checked in and carries the version; do not generate a second one -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!--
      CA1416 fires on every WinForms call because net8.0-windows still lets the
      analyser imagine a non-Windows caller.  This is a Windows-only WinForms
      app wrapping native DevIL and OpenGL; it emitted 401 of these and buried
      the warnings that matter.
    -->
    <NoWarn>CA1416</NoWarn>
    <SupportedOSPlatform>windows</SupportedOSPlatform>
  </PropertyGroup>

  <!-- namespace level imports the old project declared -->
  <ItemGroup>
    <Import Include="Microsoft.VisualBasic" />
    <Import Include="System" />
    <Import Include="System.Collections" />
    <Import Include="System.Collections.Generic" />
    <Import Include="System.Data" />
    <Import Include="System.Diagnostics" />
    <Import Include="System.Drawing" />
    <Import Include="System.Linq" />
    <Import Include="System.Threading.Tasks" />
    <Import Include="System.Windows.Forms" />
    <Import Include="System.Xml.Linq" />
  </ItemGroup>

  <ItemGroup>
    <!--
      OpenTK is held at 4.8.2 with GLControl 4.0.1, and the pins matter.

      GLControl is what lets a CORE context live inside PKG Explorer's own
      WinForms model window instead of a separate GameWindow.  But every 4.x
      GLControl demands a floor on OpenTK: 4.0.1 wants 4.8.2, 4.0.2 wants 4.9.3.
      Exporter Studio's sources - copied under Viewer\ - are written against
      4.7.1, and on 4.9.3 their AtlasFile.vb stops compiling, because
      CompressedTexSubImage3D's overloads changed.  AtlasFile is what draws the
      tiled and atlas materials, which is most of the surface of a building, so
      losing it is not an option.

      4.8.2 is the one version that satisfies both: new enough for GLControl
      4.0.1, old enough that their file builds UNMODIFIED.  The sub-packages are
      pinned explicitly because a direct PackageReference beats a transitive
      one; without them NuGet floats the graph up and the build breaks again.
    -->
    <PackageReference Include="OpenTK" Version="4.8.2" />
    <PackageReference Include="OpenTK.Core" Version="4.8.2" />
    <PackageReference Include="OpenTK.Graphics" Version="4.8.2" />
    <PackageReference Include="OpenTK.Mathematics" Version="4.8.2" />
    <PackageReference Include="OpenTK.Windowing.Common" Version="4.8.2" />
    <PackageReference Include="OpenTK.Windowing.Desktop" Version="4.8.2" />
    <PackageReference Include="OpenTK.Windowing.GraphicsLibraryFramework" Version="4.8.2" />
    <PackageReference Include="OpenTK.GLControl" Version="4.0.1" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.7" />
    <!-- codepage 437 for DotNetZip entry names; .NET 8 drops the legacy pages -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="5.0.0" />
  </ItemGroup>

  <!-- local assemblies that are pure IL and therefore still load on net8 -->
  <ItemGroup>
    <Reference Include="Ionic.Zip">
      <HintPath>zip\Ionic.Zip.dll</HintPath>
    </Reference>
    <Reference Include="Tao.DevIl">
      <HintPath>Tao.DevIl.dll</HintPath>
    </Reference>
    <Reference Include="Tao.OpenGl">
      <HintPath>Tao.OpenGl.dll</HintPath>
    </Reference>
    <Reference Include="Tao.FreeGlut">
      <HintPath>Tao.FreeGlut.dll</HintPath>
    </Reference>
    <Reference Include="Tao.Platform.Windows">
      <HintPath>Tao.Platform.Windows.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- native + runtime payload that has to sit next to the exe -->
  <ItemGroup>
    <None Include="DevIL.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="ILU.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="ILUT.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="freeglut.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="App.config" />
    <None Include="Images\**" CopyToOutputDirectory="PreserveNewest" LinkBase="images" />
    <None Include="models\**" CopyToOutputDirectory="PreserveNewest" LinkBase="models" />
    <None Include="html\**" CopyToOutputDirectory="PreserveNewest" LinkBase="html" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="My Project\Settings.Designer.vb">
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
    </Compile>
    <Compile Update="My Project\Resources.Designer.vb">
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="My Project\Resources.resx">
      <Generator>VbMyResourcesResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.vb</LastGenOutput>
      <CustomToolNamespace>My.Resources</CustomToolNamespace>
    </EmbeddedResource>
    <None Include="My Project\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <CustomToolNamespace>My</CustomToolNamespace>
      <LastGenOutput>Settings.Designer.vb</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
